with email_info as (
select date_add(s.date, interval es.sent_date day) as date,
sp.country, ac.send_interval, ac.is_verified, ac.is_unsubscribed,
count(distinct es.id_message) as sent_email_cnt, count(distinct eo.id_message) as open_email_cnt,
count(distinct ev.id_message) as visit_email_cnt
from `data-analytics-mate.DA.email_sent` es
left join `data-analytics-mate.DA.email_open` eo on es.id_message = eo.id_message
left join `data-analytics-mate.DA.email_visit` ev on es.id_message = ev.id_message
join `data-analytics-mate.DA.account` ac on es.id_account = ac.id
join `data-analytics-mate.DA.account_session` acs on es.id_account = acs.account_id
join `data-analytics-mate.DA.session` s on acs.ga_session_id = s.ga_session_id
join `data-analytics-mate.DA.session_params` sp on s.ga_session_id = sp.ga_session_id
group by date_add(s.date, interval es.sent_date day), sp.country, ac.send_interval, ac.is_verified, ac.is_unsubscribed
),

acc_info as (
select s.date, sp.country, a.send_interval, a.is_verified, a.is_unsubscribed,
count(a.id) as acc_cnt
from `data-analytics-mate.DA.account` a
join `data-analytics-mate.DA.account_session` acs on a.id = acs.account_id
join `data-analytics-mate.DA.session` s on acs.ga_session_id = s.ga_session_id
join `data-analytics-mate.DA.session_params` sp on s.ga_session_id = sp.ga_session_id
group by s.date, sp.country, a.send_interval, a.is_verified, a.is_unsubscribed
),

union_info as (
select
 date,
 country,
 send_interval,
 is_verified,
 is_unsubscribed,
 sum(acc_cnt) as account_cnt,
 sum(sent_email_cnt) as sent_email_cnt,
 sum(open_email_cnt) as open_email_cnt,
 sum(visit_email_cnt) as visit_email_cnt
from(
select
 e.date,
 e.country,
 e.send_interval,
 e.is_verified,
 e.is_unsubscribed,
 0 as acc_cnt,
 e.sent_email_cnt,
 e.open_email_cnt,
 e.visit_email_cnt
from email_info e
union all
select
 a.date,
 a.country,
 a.send_interval,
 a.is_verified,
 a.is_unsubscribed,
 a.acc_cnt,
 0 as sent_email_cnt,
 0 as open_email_cnt,
 0 as visit_email_cnt
from acc_info a)
group by
 date,
 country,
 send_interval,
 is_verified,
 is_unsubscribed
),

total_metrics as (
select *,
sum(account_cnt) over(partition by country) as total_country_account_cnt,
sum(sent_email_cnt) over(partition by country) as total_country_sent_cnt
from union_info
),

rank_result as (
select *,
dense_rank() over(order by total_country_account_cnt desc) as rank_total_country_account_cnt,
dense_rank() over(order by total_country_sent_cnt desc) as rank_total_country_sent_cnt
from total_metrics
)

select *
from rank_result
where rank_total_country_account_cnt <= 10 or rank_total_country_sent_cnt <= 10
order by total_country_account_cnt desc, total_country_sent_cnt desc
